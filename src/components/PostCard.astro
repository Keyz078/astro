---
// Reusable post card used on homepage and /notes
const { post, compact = false } = Astro.props;
---

<article class={compact ? 'bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-md p-3 text-sm' : 'bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-6'}>
  <a href={`/blog/${post.slug}/`} class="block no-underline">
    <div class="flex items-start justify-between gap-4">
      <h3 class={compact ? 'text-sm font-medium text-gray-900 dark:text-gray-100' : 'text-lg font-semibold text-gray-900 dark:text-gray-100'}>{post.data.title}</h3>
      <time class="text-xs text-gray-500 dark:text-gray-400">{new Date(post.data.date).toLocaleDateString()}</time>
    </div>

    <p class={compact ? 'mt-2 text-sm text-gray-600 dark:text-gray-300' : 'mt-3 text-sm text-gray-600 dark:text-gray-300'}>{post.data.description}</p>

    {post.data.tags?.length ? (
      <div class={compact ? 'mt-2 flex flex-wrap gap-2' : 'mt-4 flex flex-wrap gap-2'}>
        {post.data.tags.map((t) => (
          <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded">{t}</span>
        ))}
      </div>
    ) : null}
  </a>
</article>
