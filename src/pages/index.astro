---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('notes');
const posts = allPosts
  .filter((p) => !p.data.isDraft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Featured (optional) - up to 3
const featuredPosts = posts.filter((p) => p.data.featured).slice(0, 3);
const featuredSlugs = new Set(featuredPosts.map((p) => p.slug));

// Latest Notes: exclude featured, extract hero + next 5
const primary = posts.filter((p) => !featuredSlugs.has(p.slug));
const latestHero = primary.length ? primary[0] : null;
const latestGrid = primary.slice(1, 6);
---

<BaseLayout pageTitle="Home">
  <section class="mb-10">
    <h2 class="text-2xl font-semibold mb-6">Latest Notes</h2>

    <div class="grid gap-6">
      {latestHero ? (
        <div>
          <PostCard post={latestHero} hero={true} />
        </div>
      ) : null}

      <div class="grid gap-6 grid-cols-2 md:grid-cols-3">
        {latestGrid.map((post) => (
          <PostCard post={post} compact={true} />
        ))}
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/notes" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:underline">View All Notes →</a>
    </div>
  </section>

  {featuredPosts.length ? (
    <section class="mt-12">
      <h2 class="text-xl font-semibold mb-4">Featured</h2>
      <div class="grid gap-4 grid-cols-1 md:grid-cols-3">
        {featuredPosts.map((post) => (
          <PostCard post={post} compact={true} />
        ))}
      </div>
    </section>
  ) : null}
</BaseLayout>