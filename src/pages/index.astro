---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => !p.data.isDraft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const featured = posts.slice(0, 3);
const rest = posts.slice(3);
---

<BaseLayout pageTitle="Home">
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Featured</h2>

    <div class="grid gap-6 grid-cols-1 md:grid-cols-3">
      {featured.map((post) => (
        <article class="group bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-6 transition-shadow hover:shadow-lg">
          <a href={`/blog/${post.slug}/`} class="block">
            <header>
              <h3 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-gray-100">{post.data.title}</h3>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{post.data.description}</p>
            </header>

            <div class="mt-4 flex flex-wrap gap-2">
              {post.data.tags?.map((tag) => (
                <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded">{tag}</span>
              ))}
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-4">All Notes</h2>

    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => (
        <article class="bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-md p-4 hover:shadow-sm transition">
          <a href={`/blog/${post.slug}/`} class="block">
            <div class="flex items-start justify-between">
              <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">{post.data.title}</h3>
              <time class="text-xs text-gray-500 dark:text-gray-400">{new Date(post.data.date).toLocaleDateString()}</time>
            </div>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{post.data.description}</p>

            <div class="mt-3 flex flex-wrap gap-2">
              {post.data.tags?.map((tag) => (
                <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded">{tag}</span>
              ))}
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>